{
  "name": "Kalkulator Python",
  "image": "://microsoft.com",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "Kalkulator": {
            "path": "python3",
            "args": ["${workspaceFolder}/main.py"]
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}